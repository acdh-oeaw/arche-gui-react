# dependencies
node_modules/
.pnpm-store/

# logs
*.log

# non-public environment variables
.env.keys
.env.local
.env.*.local

# caches
.eslintcache
.prettiercache
.stylelintcache
*.tsbuildinfo

# performance profiles
*.cpuprofile
*.heapprofile
*.heapsnapshot

# vercel
.vercel

# misc
.DS_Store
*.pem
.idea/

# next.js
.next/
next-env.d.ts
out/

# i18n
/content/**/*.d.json.ts
/messages/**/*.d.json.ts

# static content
# The html files are fetched from the upstream github repo at runtime by `/api/static-content`, so
# they are build output, not source. Keep the two directories in the repo (via `.gitkeep`) and
# ignore everything else inside them.
/static-content/de/*
/static-content/en/*
!/static-content/de/.gitkeep
!/static-content/en/.gitkeep

# test
/coverage/

# playwright
/blob-report/
/playwright/.cache/
/playwright-report/
/test-results/

.claude/
.vscode/
